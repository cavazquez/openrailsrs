# Native Windows captures are immutable byte sequences verified by SHA-256.
# Keep CRLF/UTF-16 intact, including on clones with core.autocrlf enabled.
examples/baselines/chiltern_local/** -text whitespace=cr-at-eol
examples/baselines/class47/** -text whitespace=cr-at-eol
tools/openrails-reference/FormationCapture.cs -text
# Parameter exports retain author whitespace; immutable oracle hashes cover it.
examples/brake_supply_native/** -text
examples/brake_supply_native/vehicles/* -whitespace
tools/openrails-reference/BrakePowerReference.cs -text
oracles/openrails-brake-power*.json -text
# New native DLL oracles also retain the captured bytes and their hashes.
oracles/openrails-cab.json -text whitespace=cr-at-eol
oracles/openrails-parser.json -text whitespace=cr-at-eol
oracles/openrails-signals.json -text whitespace=cr-at-eol
oracles/openrails-lirr-parameters.json -text whitespace=cr-at-eol
oracles/openrails-consumable-mass.json -text whitespace=cr-at-eol
tools/openrails-reference/ConsumableMassReference.cs -text
# Captured operational references remain identical with autocrlf on any clone.
docs/fixtures/compatibility/*-or161/** -text whitespace=cr-at-eol
tools/openrails-reference/BogieDynamicsReference.cs -text
tools/openrails-reference/OperationalSignalsReference.cs -text
tools/openrails-reference/TrackSoundReference.cs -text
scripts/capture_bogie_dynamics_reference.py -text
scripts/capture_operational_signals_reference.py -text
scripts/capture_track_sound_reference.py -text
# Raw test output keeps its terminal newline and byte hashes.
docs/fixtures/operations/**/*.log -text whitespace=-blank-at-eof
