(Engine
  (Comment "Original openrailsrs operational-yard test vehicle. ORTS stiffness values are forces in newtons.")
  (Name "Diésel de maniobras: acoplador reforzado")
  (Type Diesel)
  (Mass 40000)
  (Size 3 4 20)
  (MaxPower 1000000)
  (MaxForce 100000)
  (MaxVelocity 60km/h)
  (MaxBrakeForce 180000)
  (BrakeSystemType Air_single_pipe)
  (DieselEngineIdleRPM 300)
  (DieselEngineMaxRPM 900)
  (DieselEngineMaxRPMChangeRate 80)
  (MaxDieselLevel 200l)
  (DieselUsedPerHourAtIdle 18l)
  (DieselUsedPerHourAtMaxPower 180l)
  (Coupling
    (Type Automatic)
    (Spring
      (ORTSTensionStiffness 100kN 500kN)
      (ORTSCompressionStiffness 150kN 500kN)
      (ORTSTensionR0 0m 0.01m)
      (ORTSCompressionR0 0m 0.005m)
      (ORTSTensionSlack 0.02m 0.04m)
      (ORTSCompressionSlack 0.015m 0.03m)
      (ORTSBreak 600kN 800kN)
    )
  )
)
