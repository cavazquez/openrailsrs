(Engine
  (Name "Electric supply test")
  (Type Electric)
  (WagonShape "two_pantographs.s")
  (Mass 40000)
  (Size 3 4 20)
  (MaxPower 1000000)
  (MaxForce 100000)
  (MaxVelocity 120)
  (MaxBrakeForce 120000)
  (ORTSCircuitBreakerClosingDelay 1s)
  (ORTSPowerOnDelay 0.5s)
  (ORTSPantographs (Pantograph (Delay 1s) (ORTSRSOffset 8m)) (Pantograph (Delay 2s) (ORTSRSOffset -8m)))
)
